{
  "name": "@guardcore/express",
  "version": "4.3.2",
  "description": "Express adapter for @guardcore/core security middleware",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@guardcore/core": "workspace:^",
    "guardagent": "^3.2.1"
  },
  "devDependencies": {
    "@types/express": "^5",
    "cors": "^2.8.5",
    "tsup": "^8",
    "typescript": "~5.9",
    "@vitest/coverage-v8": "^5.0.2",
    "vitest": "^5"
  },
  "peerDependencies": {
    "express": "^4 || ^5",
    "cors": "^2"
  },
  "peerDependenciesMeta": {
    "cors": {
      "optional": true
    }
  },
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Guard-Core/guard-core-ts.git",
    "directory": "packages/express"
  },
  "publishConfig": {
    "access": "public"
  }
}
