{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["conformance/**"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    /* The coverage gate must always execute: a cached replay would skip the
       threshold enforcement and leave no fresh coverage artifacts for the ci
       report assertion. */
    "test:coverage": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "lint": {},
    "clean": {
      "cache": false
    }
  }
}
